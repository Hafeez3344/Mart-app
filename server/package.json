{
  "name": "super-mart-server",
  "version": "1.0.0",
  "description": "Super Mart Point of Sale & Inventory Express API Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "prisma generate && prisma db push && nodemon src/server.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:sync": "prisma generate && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0"
  }
}
